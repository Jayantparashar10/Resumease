# Providers
AUTH_PROVIDER=supabase
DATABASE_PROVIDER=supabase

# ── Environment ────────────────────────────────────────────────────────
# Set to "development" locally. NEVER set to "development" in production.
# Controls: API docs visibility (/docs, /redoc), DEBUG tracebacks.
ENVIRONMENT=development
DEBUG=false

# ── JWT ────────────────────────────────────────────────────────────────
# REQUIRED. Must be a cryptographically random secret of at least 32 characters (256 bits).
# The application will REFUSE to start if this is empty or set to the placeholder.
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_RANDOM_256_BIT_HEX_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ── Google OAuth ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Supabase ────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── GitHub (optional) ───────────────────────────────────────────────────
GITHUB_TOKEN=

# ── Cerebras LLM (optional) ─────────────────────────────────────────────
# Falls back to rule-based scoring if not set.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production, replace with your actual frontend domain.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
