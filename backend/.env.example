# Providers
AUTH_PROVIDER=supabase
DATABASE_PROVIDER=supabase

# JWT
JWT_SECRET=change-me-to-something-secure-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Google OAuth
GOOGLE_CLIENT_ID=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub (optional)
GITHUB_TOKEN=

# Cerebras LLM (optional — falls back to rule-based scoring if not set)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# CORS
# Comma-separated values are recommended for serverless environments.
# You can also use JSON array format if preferred.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
